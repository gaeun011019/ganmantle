# python scripts/setup_env.py가 임의 비밀번호를 생성합니다. 이 파일에는 비밀값이 없습니다.
POSTGRES_DB=ganmantle
POSTGRES_USER=ganmantle
POSTGRES_PASSWORD=
APP_PORT=8000
APP_IMAGE=ganmantle-v1-app:local
# 로컬 HTTP는 아래 기본값. HTTPS 운영은 docs/DEPLOYMENT.md를 따릅니다.
APP_ORIGIN=
COOKIE_SECURE=false
# 모델은 compose.yaml의 model_data 볼륨을 사용합니다.
